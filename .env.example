# SQLite file, created by `npm run setup`. Path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ── Email (optional) ─────────────────────────────────────────────────────────
# Every notification is always logged to the outbox (/dev/outbox). Set SMTP_* to ALSO send real email.
# Gmail: use an App Password (Google Account → Security → App passwords), SMTP_HOST=smtp.gmail.com, SMTP_PORT=465.
APP_URL="http://100.95.56.19:3000"   # base for links in emails
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# EMAIL_FROM="burrow <you@gmail.com>"
# Demo: deliver sample people's mail (priya@example.edu, …) to one real inbox as you+priya@gmail.com.
# EMAIL_REDIRECT="you@gmail.com"
# Safety: real sends only go to these domains/addresses (comma-separated). Sample users are @example.edu
# and are never sent to. Leave unset to allow any non-example address.
# EMAIL_ALLOW="umich.edu,gmail.com"

# Live demo: pre-fill the leaver's invite form with the stayer teammate (client-visible; demo only).
# NEXT_PUBLIC_DEMO_STAYER_NAME="Tom"
# NEXT_PUBLIC_DEMO_STAYER_EMAIL="stayer@umich.edu"

# Passcode for Reset demo on the public address (*.ts.net via Tailscale Funnel).
# DEMO_RESET_CODE="choose-one"
