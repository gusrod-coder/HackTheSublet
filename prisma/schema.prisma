// Householdfit data model. OWNER: h1. Change only via a [REQ] to h1.
// SQLite notes: no enums or scalar lists, so
//   - enum-like fields are String (allowed values documented + validated in lib/types.ts)
//   - int[8] answers/weights and string[] deal-breakers are JSON strings (parsed in lib/repo.ts)
//   - dates are "YYYY-MM-DD" strings (no timezone surprises)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  contactMethod  String? // 'email' | 'phone' | 'text' | 'instagram'
  contactValue   String?
  isSample       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  listingsLed    Listing[]        @relation("Leaver")
  memberships    Membership[]
  habitProfiles  HabitProfile[]
  incoming       IncomingProfile?
  requests       Request[]        @relation("IncomingRequests")
  approvals      Approval[]
  termAgreements TermAgreement[]
}

model Listing {
  id          String       @id @default(cuid())
  leaverId    String
  leaver      User         @relation("Leaver", fields: [leaverId], references: [id])
  name        String       @default("") // display name, e.g. "Packard St house"; "" → derive from address
  address     String
  lat         Float
  lng         Float
  area        String // neighborhood, free text ("Burns Park")
  roomType    String // 'private' | 'shared'
  startDate   String // YYYY-MM-DD
  endDate     String // YYYY-MM-DD
  houseRules  String       @default("")
  flagSmoking Boolean      @default(false)
  flagPets    Boolean      @default(false)
  furnished   Boolean      @default(true)
  rent        Int? // monthly rent in USD; null = not given. Display + budget filter only, never scored.
  status      String       @default("draft") // 'draft' | 'awaiting_household' | 'live'
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  profiles    HabitProfile[]
  requests    Request[]
}

model Membership {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String // 'leaver' | 'stayer'
  inviteStatus String   @default("invited") // 'invited' | 'answered'
  createdAt    DateTime @default(now())

  @@unique([listingId, userId])
}

// Stayer habit profile; one per (stayer, listing).
model HabitProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  answers   String // JSON int[8]
  practices String   @default("[]") // JSON PracticeKey[]: optional household practices this stayer commits to
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
}

model IncomingProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    String?
  endDate      String?
  destination  String? // 'medical' | 'central' | 'north' | 'downtown'
  flexDays     Int      @default(7) // 0 | 3 | 7 | 14 — date flexibility, display-only (never scored)
  answers      String? // JSON (int|null)[8]
  weights      String   @default("[1,1,1,1,1,1,1,1]") // JSON (0|1|3)[8]
  dealBreakers String   @default("[]") // JSON DealBreakerKey[]
  mustHaves    String   @default("[]") // JSON PracticeKey[]: household practices the incoming requires
  minRent      Int? // optional lower end of the price range in USD; listings below it are excluded with a reason
  maxRent      Int? // optional monthly budget in USD; listings above it are excluded with a reason
  complete     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model Request {
  id         String          @id @default(cuid())
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  incomingId String
  incoming   User            @relation("IncomingRequests", fields: [incomingId], references: [id], onDelete: Cascade)
  status     String          @default("sent") // 'sent' | 'approved' | 'declined'
  contactsNotifiedAt DateTime? // set once the "contacts unlocked" email went out
  sharedPhone String? // optional: the incoming chose to share this number with the stayers when requesting
  createdAt  DateTime        @default(now())
  approvals  Approval[]
  terms      TermAgreement[]

  @@unique([listingId, incomingId])
}

model Approval {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stayerId  String
  stayer    User     @relation(fields: [stayerId], references: [id], onDelete: Cascade)
  decision  String // 'approve' | 'pass'
  createdAt DateTime @default(now())

  @@unique([requestId, stayerId])
}

model TermAgreement {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termKey   String // TermKey
  agreed    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([requestId, userId, termKey])
}

// Agent mailbox (h1/h2/h3 coordination over the tailnet). Not product data; demo reset leaves it alone.
model Mail {
  id        String    @id @default(cuid())
  from      String // 'h1' | 'h2' | 'h3'
  to        String // 'h1' | 'h2' | 'h3' | 'all'
  subject   String
  body      String    @default("")
  inReplyTo String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([to, readAt])
}

// Notification emails (spec: notifications only — never in-app messaging, never contact details).
// Every email is logged here; it is also sent over SMTP when SMTP_* env vars are set.
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  toUserId  String?
  kind      String // 'invite' | 'listing_live' | 'request_received' | 'request_approved' | 'request_declined' | 'contacts_unlocked'
  subject   String
  text      String
  link      String?
  status    String   @default("logged") // 'logged' (outbox only) | 'sent' | 'failed' | 'skipped'
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
