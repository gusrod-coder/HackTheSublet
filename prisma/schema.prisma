// Householdfit data model. OWNER: h1. Change only via a [REQ] to h1.
// SQLite notes: no enums or scalar lists, so
//   - enum-like fields are String (allowed values documented + validated in lib/types.ts)
//   - int[8] answers/weights and string[] deal-breakers are JSON strings (parsed in lib/repo.ts)
//   - dates are "YYYY-MM-DD" strings (no timezone surprises)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  contactMethod  String? // 'email' | 'phone' | 'text' | 'instagram'
  contactValue   String?
  isSample       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  listingsLed    Listing[]        @relation("Leaver")
  memberships    Membership[]
  habitProfiles  HabitProfile[]
  incoming       IncomingProfile?
  requests       Request[]        @relation("IncomingRequests")
  approvals      Approval[]
  termAgreements TermAgreement[]
}

model Listing {
  id          String       @id @default(cuid())
  leaverId    String
  leaver      User         @relation("Leaver", fields: [leaverId], references: [id])
  address     String
  lat         Float
  lng         Float
  area        String // neighborhood, free text ("Burns Park")
  roomType    String // 'private' | 'shared'
  startDate   String // YYYY-MM-DD
  endDate     String // YYYY-MM-DD
  houseRules  String       @default("")
  flagSmoking Boolean      @default(false)
  flagPets    Boolean      @default(false)
  status      String       @default("draft") // 'draft' | 'awaiting_household' | 'live'
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  profiles    HabitProfile[]
  requests    Request[]
}

model Membership {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String // 'leaver' | 'stayer'
  inviteStatus String   @default("invited") // 'invited' | 'answered'
  createdAt    DateTime @default(now())

  @@unique([listingId, userId])
}

// Stayer habit profile; one per (stayer, listing).
model HabitProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  answers   String // JSON int[8]
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
}

model IncomingProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    String?
  endDate      String?
  destination  String? // 'medical' | 'central' | 'north' | 'downtown'
  answers      String? // JSON (int|null)[8]
  weights      String   @default("[1,1,1,1,1,1,1,1]") // JSON (0|1|3)[8]
  dealBreakers String   @default("[]") // JSON DealBreakerKey[]
  complete     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model Request {
  id         String          @id @default(cuid())
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  incomingId String
  incoming   User            @relation("IncomingRequests", fields: [incomingId], references: [id], onDelete: Cascade)
  status     String          @default("sent") // 'sent' | 'approved' | 'declined'
  createdAt  DateTime        @default(now())
  approvals  Approval[]
  terms      TermAgreement[]

  @@unique([listingId, incomingId])
}

model Approval {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stayerId  String
  stayer    User     @relation(fields: [stayerId], references: [id], onDelete: Cascade)
  decision  String // 'approve' | 'pass'
  createdAt DateTime @default(now())

  @@unique([requestId, stayerId])
}

model TermAgreement {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termKey   String // TermKey
  agreed    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([requestId, userId, termKey])
}
